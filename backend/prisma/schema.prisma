// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER") // USER, ADMIN
  hashedRt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // A user can place multiple orders over time.
  // One-to-many relationship with Order model.
  orders    Order[]

  // A user can write multiple reviews.
  // One-to-many relationship with Review model.
  reviews   Review[]
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  image       String?
  category    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A product can be part of multiple order line-items across different orders.
  // One-to-many relationship with OrderItem model.
  orderItems  OrderItem[]

  // A product can have multiple reviews.
  // One-to-many relationship with Review model.
  reviews     Review[]
}

// Order model tracks high-level information about a customer purchase.
model Order {
  id          String      @id @default(uuid())
  userId      String      // Foreign key linking to the User who placed the order
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float       // Stored total calculated on the backend to prevent tampering
  status      String      @default("PENDING") // Status states: PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String
  shippingPhone      String
  shippingEmail      String
  shippingLocalAddress String
  couponId    String?
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  discountAmount Float    @default(0)
  paymentMethod  String?
  paymentId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // An order can consist of multiple individual line items.
  // One-to-many relationship with OrderItem, cascade deletes if the parent Order is deleted.
  items       OrderItem[]
}

model Coupon {
  id             String      @id @default(uuid())
  code           String      @unique
  discountType   String      // PERCENTAGE, FLAT
  value          Float
  minOrderAmount Float       @default(0)
  maxUses        Int?
  usedCount      Int         @default(0)
  active         Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders         Order[]
}

// OrderItem model tracks individual line-items within an Order.
// It stores a snapshot of the product price at checkout to ensure historical accuracy.
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   // Foreign key linking to the parent Order
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   // Foreign key linking to the Product purchased
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      // The quantity of this product purchased
  price     Float    // Snapshot of the price per unit at the time of order placement
}

// Review model stores user feedback and numeric rating for a product.
model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1 to 5 stars
  comment   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // One review per product per user
}


